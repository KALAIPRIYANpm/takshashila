{
  "name": "takshashila",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Takshashila: scholarships and student empowerment platform (React + Node.js)",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "db:up": "docker compose up -d db",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "add-staff": "node --env-file-if-exists=.env server/add-staff.js"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.0"
  }
}
