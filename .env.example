# Copy to .env for local overrides. On Render/Railway set these in the dashboard instead.

# PostgreSQL. Development defaults to the docker-compose database (npm run db:up).
DATABASE_URL=postgres://takshashila:takshashila@localhost:5432/takshashila
# 1 = connect with TLS (needed for Neon, Supabase, or any database reached over the public internet).
DATABASE_SSL=0

# Signs session cookies and salts Aadhaar hashes. Required in production, 32+ random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it later signs everyone out AND breaks duplicate-Aadhaar detection for existing applications.
SECRET_KEY=

# MSG91 (https://msg91.com): auth key, and the DLT-approved Flow template that contains the OTP variable.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp

# Uploaded documents and videos. In Docker this is /var/data/uploads on a persistent disk.
# UPLOAD_DIR=

# Demo mode shows login codes on screen. On by default in development; in production only if set to 1.
# DEMO_MODE=0

# PORT=4000
# DATABASE_POOL_SIZE=10
